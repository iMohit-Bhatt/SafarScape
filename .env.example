# ─── Safarscape environment ───────────────────────────────────────────────
# Copy to .env.local for development. Everything is optional for local dev:
# with no variables set the app runs on an embedded Postgres in ./.data,
# seeds demo content, and records emails in the admin instead of sending them.

# Public URL of the site (used for canonical links, sitemap, emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database ──
# Local default: embedded Postgres (PGlite) stored on disk.
# DATABASE_URL=pglite://./.data/pglite
# Production: any Postgres (Neon, Supabase, RDS…). Use the pooled connection string.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Migrations run automatically on boot; set to false if you run them separately.
# DB_AUTO_MIGRATE=true
# Seed demo staff/catalogue when the database is empty (turn off in production once real data exists).
# SEED_ON_START=true
# Also create sample leads ("Demo lead · …") when seeding.
# SEED_DEMO_LEADS=true
# Password for the seeded staff accounts (default: Safarscape#2026). CHANGE IT before going live.
# Required on a real Postgres database; the app refuses to seed staff with the demo password there.
# SEED_ADMIN_PASSWORD=
# Disposable test databases only: allow the demo password.
# SEED_ALLOW_DEMO_PASSWORD=false

# ── Email ──
# Without RESEND_API_KEY, emails are logged in the admin (lead → Emails tab) but not delivered.
# RESEND_API_KEY=
# EMAIL_FROM="Safarscape <enquiries@yourdomain.in>"   # must be a verified sender domain in Resend
# Force a provider: outbox | fail (simulates failures to test the retry flow)
# EMAIL_PROVIDER=
# Used only if no team recipients are configured in Admin → Email & routing.
# ENQUIRY_FALLBACK_EMAIL=

# ── Spam protection (Cloudflare Turnstile) ──
# Leave both empty to disable (honeypot + rate limiting still apply).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Max enquiries per IP per 10 minutes (default 8).
# ENQUIRY_RATE_LIMIT=8

# ── Contact fallbacks (admin settings take precedence) ──
# NEXT_PUBLIC_WHATSAPP_NUMBER=+91XXXXXXXXXX
# AGENCY_PHONE=+91XXXXXXXXXX

# ── Analytics (loaded only after the visitor accepts cookies) ──
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=

# ── Tests ──
# Path to a Chromium binary if `npx playwright install chromium` isn't possible.
# PW_CHROMIUM_PATH=
