# Safarscape — local settings (not committed to git)

# Supabase project "safarscape" (Mumbai, ap-south-1)
# Session pooler: works on IPv4 networks; good for `npm run dev` and long-running servers.
# Replace YOUR-PASSWORD with the database password you saved when the project was created.
# If it contains special characters (@ : / ? # %), percent-encode them.
DATABASE_URL=postgresql://postgres.qovqloshcuvaeyxjhmqw:wp6sA8a4Uw2Rs2nJskfKWBzx@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# For serverless hosting (e.g. Vercel) use the transaction pooler instead (port 6543):
# DATABASE_URL=postgresql://postgres.qovqloshcuvaeyxjhmqw:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# First start fills the empty database with the demo catalogue and staff accounts.
# Set your own staff password here BEFORE the first start (min 10 chars, letters + a number).
SEED_ADMIN_PASSWORD=SafarScape@2026!
# Skip the sample "Demo lead · …" enquiries in the real database.
SEED_DEMO_LEADS=false

NEXT_PUBLIC_SITE_URL=http://localhost:3000
